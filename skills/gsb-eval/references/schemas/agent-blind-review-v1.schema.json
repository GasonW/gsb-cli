{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-blind-review-v1.schema.json",
  "title": "GSB Agent Blind Review v1 JSONL record",
  "type": "object",
  "required": [
    "schema_version",
    "query_id",
    "pass",
    "anonymous_order",
    "input_hash",
    "prompt",
    "model",
    "pointwise",
    "pairwise",
    "answer_a",
    "answer_b",
    "common_issues",
    "evidence",
    "requires_fact_check"
  ],
  "properties": {
    "schema_version": {"const": "gsb-agent-blind-review/v1"},
    "query_id": {"type": "string", "minLength": 1},
    "pass": {"type": "integer", "enum": [1, 2]},
    "anonymous_order": {
      "type": "object",
      "required": ["A", "B"],
      "properties": {
        "A": {"type": "string", "minLength": 1},
        "B": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "input_hash": {"type": "string", "minLength": 1},
    "prompt": {
      "type": "object",
      "required": ["version", "sha256"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "required": ["provider", "id", "parameters"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1},
        "parameters": {"type": "object"}
      },
      "additionalProperties": false
    },
    "pointwise": {
      "type": "object",
      "required": ["A", "B"],
      "properties": {
        "A": {"type": "number", "minimum": 0, "maximum": 3},
        "B": {"type": "number", "minimum": 0, "maximum": 3}
      },
      "additionalProperties": false
    },
    "pairwise": {
      "type": "object",
      "required": ["overall", "need_fit", "fact_reason", "language", "presentation", "professional"],
      "properties": {
        "overall": {"$ref": "#/$defs/pairwiseScore"},
        "need_fit": {"$ref": "#/$defs/pairwiseScore"},
        "fact_reason": {"$ref": "#/$defs/pairwiseScore"},
        "language": {"$ref": "#/$defs/pairwiseScore"},
        "presentation": {"$ref": "#/$defs/pairwiseScore"},
        "professional": {"$ref": "#/$defs/pairwiseScore"}
      },
      "additionalProperties": false
    },
    "answer_a": {"$ref": "#/$defs/answerAssessment"},
    "answer_b": {"$ref": "#/$defs/answerAssessment"},
    "common_issues": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
    "requires_fact_check": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "generated_at": {"type": "string"}
  },
  "$defs": {
    "pairwiseScore": {"type": "integer", "minimum": -2, "maximum": 2},
    "answerAssessment": {
      "type": "object",
      "required": ["strengths", "unique_issues"],
      "properties": {
        "strengths": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "unique_issues": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["ref", "claim"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "claim": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
