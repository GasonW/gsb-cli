{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "case-evidence-v2.schema.json",
  "title": "GSB Case Evidence v2",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["query_id", "query", "status", "candidate_response", "baseline_response", "conflict_codes"],
    "properties": {
      "query_id": {"type": "string", "minLength": 1},
      "query": {"type": "string"},
      "status": {"enum": ["main_analysis", "review_required"]},
      "candidate_response": {"type": "string"},
      "baseline_response": {"type": "string"},
      "comments": {"type": "array"},
      "conflict_codes": {"type": "array", "items": {"type": "string"}}
    },
    "additionalProperties": true
  }
}
