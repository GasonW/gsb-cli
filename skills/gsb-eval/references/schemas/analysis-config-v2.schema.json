{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analysis-config-v2.schema.json",
  "title": "GSB Decision Analysis Config v2",
  "type": "object",
  "required": ["protocol_version"],
  "properties": {
    "protocol_version": {"const": "gsb-decision-v2"},
    "candidate": {"type": "string", "minLength": 1},
    "baseline": {"type": "string", "minLength": 1},
    "minimum_valid_workers_without_qc": {"type": "integer", "minimum": 1},
    "pointwise": {"type": "object", "properties": {"pass_threshold": {"type": "number", "minimum": 0, "maximum": 3}}},
    "worker_quality": {
      "type": "object",
      "properties": {
        "downweight": {"type": "number", "minimum": 0, "maximum": 1},
        "overrides": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["state", "reason"],
            "properties": {
              "state": {"enum": ["retain", "downweight", "exclude"]},
              "confirmed": {"type": "boolean"},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "decision_thresholds": {"type": "object"},
    "bootstrap": {"type": "object", "properties": {"iterations": {"type": "integer", "minimum": 100}, "seed": {"type": "integer"}}},
    "semantic_analysis": {
      "type": "object",
      "properties": {
        "protocol_version": {"const": "gsb-semantic-analysis-v1"},
        "coverage": {"const": "all_evaluated_questions"},
        "blind_passes_per_question": {"const": 2},
        "swap_answer_order": {"const": true},
        "prompt_version": {"type": "string", "minLength": 1},
        "model_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "method_overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "original_rule", "new_rule", "reason", "declared_by"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "original_rule": {},
          "new_rule": {},
          "reason": {"type": "string", "minLength": 1},
          "declared_by": {"const": "user"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
